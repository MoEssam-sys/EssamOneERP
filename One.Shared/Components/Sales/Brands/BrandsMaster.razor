@page "/sales/brands"
@using System.Net.Http.Json
@using One.Domain.Base
@using One.Domain.DTOs
@using One.Domain.DTOs.Sales
@using One.Domain.Entities.Sales
@using One.Shared.Services.Extenstions
@implements IDisposable

<OneBreadcrumbs BreadItems="_breadcrumbs" BreadColor="Color.Primary" />

<MudGrid Class="mt-4">
    <!-- Form -->
    <MudItem xs="12">
        <MudCard Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">@trgma.Details</MudText>
            <MudDivider Class="mb-3" />

            <MudForm @ref="FormRef" @bind-IsValid="FormValid">
                <MudTextField @bind-Value="FormCode"
                              Label="@trgma.Code"
                              Required="true"
                              Disabled="@_isEditing"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />

                <MudTextField @bind-Value="FormName"
                              Label="@trgma.Name"
                              Required="true"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined" />

                <MudSwitch T="bool"
                           @bind-Value="FormIsActive"
                           Color="Color.Success"
                           Class="mt-2"
                           Label="@trgma.Active" />

                <MudStack Row Class="mt-3" Spacing="2">
                    <OneLoadingBtn ButtonText="@(_isEditing? trgma.Update: trgma.Create)"
                                   LoadingText="@trgma.Saving"
                                   Color="Color.Primary"
                                   OnClick="@SaveAsync" />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               OnClick="@ResetForm">
                        @trgma.Cancel
                    </MudButton>
                </MudStack>
            </MudForm>
        </MudCard>
    </MudItem>

    <!-- Table -->
    <MudItem xs="12">
        <MudCard Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">@trgma.BrandsList</MudText>
            <MudDivider Class="mb-3" />

            <MudDataGrid @ref="_grid"
                         T="Brands"
                         Items="BrandRows"
                         Hover="true"
                         Dense="true"
                         Bordered="true"
                         Elevation="0"
                         Filterable="false"
                         RowClick="OnRowClick">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@trgma.Brands</MudText>
                    <MudSpacer />
                    <MudTextField T="string"
                                  Value="_search"
                                  ValueChanged="OnSearch"
                                  Placeholder="@trgma.SearchByCodeOrName"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Class="mt-0" />
                </ToolBarContent>

                <Columns>
                    <PropertyColumn T="Brands" TProperty="string" Property="x => x.Code" Title="@trgma.Code" />
                    <PropertyColumn T="Brands" TProperty="string" Property="x => x.Name" Title="@trgma.Name" />
                    <TemplateColumn T="Brands" Title="@trgma.Status">
                        <CellTemplate>
                            @if (context.Item.IsActive)
                            {
                                <MudChip T="@string" Color="Color.Success" Variant="Variant.Outlined">@trgma.Active</MudChip>
                            }
                            else
                            {
                                <MudChip T="@string" Color="Color.Error" Variant="Variant.Outlined">@trgma.Inactive</MudChip>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Class="ms-2"
                                           OnClick="@(() => ConfirmAndDeleteAsync(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="Brands" />
                </PagerContent>
            </MudDataGrid>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    // ====== Breadcrumb ======
    List<BreadcrumbItem> _breadcrumbs;

    // ====== Form ======
    MudForm FormRef = new();
    bool FormValid;
    bool _isEditing = false;
    Guid? EditingId = null;

    string? _search;
    string FormCode = string.Empty;
    string FormName = string.Empty;
    bool FormIsActive = true;

    // ====== Data ======
    List<Brands> BrandRows = new();
    MudDataGrid<Brands>? _grid;

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs = new()
        {
            new(trgma.Settings, href: "/settings"),
            new(trgma.Brands, href: "/sales/brands", disabled: true)
        };

        await LoadAsync();
    }

    // -------- API Calls --------
    async Task LoadAsync(int pageNumber = 1, int pageSize = 10, string? query = null)
    {
        try
        {
            var filter = new FilterBrandRequest
            {
                PageNumber = pageNumber,
                PageSize = pageSize,
            };

            var res = await _http.PostResultAsync<PagedResult<Brands>, FilterBrandRequest>(
                "api/sales/brands/filter",
                filter,
                onError: trgma.FailedToLoadData,
                ui: _msg,
                ct: _cts.Token
            );

            if (res.Success)
            {
                BrandRows = res.Data?.Items?.ToList() ?? [];
            }
        }
        catch (Exception ex)
        {
            await _msg.ExceptionHandle("UnExpectedError", ex);
        }

        StateHasChanged();
    }

    // Use the DataGrid RowClick signature
    void OnRowClick(DataGridRowClickEventArgs<Brands> e)
    {
        var b = e.Item ?? new();
        EditingId = b.Id;
        FormCode = b.Code ?? string.Empty;
        FormName = b.Name ?? string.Empty;
        FormIsActive = b.IsActive;
        _isEditing = true;
    }

    async Task ResetForm()
    {
        EditingId = null;
        FormCode = string.Empty;
        FormName = string.Empty;
        FormIsActive = true;
        _isEditing = false;
        await FormRef.ResetAsync();
    }

    // -------- Search --------
    async Task OnSearch(string text)
    {
        try
        {
            _search = text;

            if (string.IsNullOrEmpty(_search))
            {
                await LoadAsync();
                return;
            }

            var res = await _http.PostResultAsync<List<Brands>, SearchRequest>(
                "api/sales/brands/search",
                new SearchRequest { Query = _search },
                onError: trgma.SearchFailed,
                ui: _msg,
                ct: _cts.Token
            );

            BrandRows = res.Success ? (res.Data ?? new()) : new();
        }
        catch (Exception ex)
        {
            await _msg.ExceptionHandle("UnExpectedError", ex);
            BrandRows = new();
        }
    }

    // -------- Create / Update --------
    async Task SaveAsync()
    {
        await FormRef!.Validate();
        if (!FormValid)
        {
            await _msg.CompleteRequiredFields();
            return;
        }

        try
        {
            if (_isEditing && EditingId.HasValue)
            {
                // (1) Update
                var updateDto = new UpdateBrandRequest
                {
                    Id = EditingId.Value,
                    Name = FormName,
                    IsActive = FormIsActive
                };

                var upd = await _http.PutResultAsync<bool, UpdateBrandRequest>(
                    "api/sales/brands/update",
                    updateDto,
                    onError: trgma.UpdateFailed,
                    ui: _msg,
                    ct: _cts.Token
                );

                if (upd.Success && upd.Data == true)
                {
                    // (2) Ensure activity state (لو API منفصل)
                    var activeDto = new ActiveBrandRequest { Id = EditingId.Value, IsActive = FormIsActive };
                    var act = await _http.PutResultAsync<bool, ActiveBrandRequest>(
                        "api/sales/brands/active",
                        activeDto,
                        onError: "FailedToUpdateActiveState",
                        ui: _msg,
                        ct: _cts.Token
                    );
                    if (!act.Success)
                        return;

                    await _msg.UpdatedSuccessfully("Brand");
                    await LoadAsync();
                    await ResetForm();
                }
            }
            else
            {
                var createDto = new CreateBrandRequest
                {
                    Code = FormCode,
                    Name = FormName,
                    IsActive = FormIsActive
                };


                var crt = await _http.PostResultAsync<Brands, CreateBrandRequest>(
                    "api/sales/brands/create",
                    createDto,
                    onError: trgma.CreationFailed,
                    ui: _msg,
                    ct: _cts.Token
                );

                if (crt.Success && crt.Data is not null)
                {
                    await _msg.CreatedSuccessfully("Brand");
                    await LoadAsync();
                    await ResetForm();
                }
            }
        }
        catch (Exception ex)
        {
            await _msg.ExceptionHandle("UnExpectedError", ex);
        }
    }

    // -------- Delete --------
    async Task ConfirmAndDeleteAsync(Brands row)
    {
        var ok = await _msg.DltConfirmMsg();
        if (!ok) return;

        try
        {
            // الـ DELETE عندك بياخد Body (Id) → استخدم SendResultAsync
            var del = await _http.SendResultAsync<bool>(
                HttpMethod.Delete,
                "api/sales/brands/delete",
                body: row.Id,
                onError: trgma.DeleteFailed,
                ui: _msg,
                ct: _cts.Token
            );

            if (del.Success && del.Data == true)
            {
                await _msg.DeletedSuccessfully("Brand");
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            await _msg.ExceptionHandle("UnExpectedError", ex);
        }
    }
}
