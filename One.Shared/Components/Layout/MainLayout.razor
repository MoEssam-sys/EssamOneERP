@using One.Domain.Enums
@using One.Shared.Themes.MudBlazorThemes
@using One.Shared.Services.Platform
@inject AuthenticationService authenticationService
@inject IClientStorage _clientStorage
@inherits LayoutComponentBase

@if (_initializing)
{
    <OneLoader Visible="true" Text="@trgma.Loading" LoaderType="LoaderType.OneERP" />
}
else
{
<MudLayout>

    <!-- AppBar -->
    <MudAppBar @key="_localizer.CurrentCulture" Elevation="1" Color="Color.Primary">
        <!-- زرار فتح/قفل الـ Drawer -->
        <MudTooltip Text="@trgma.OpenCloseDrawer" Color="Color.Primary" Placement="Placement.Bottom" Arrow="true">
        <MudIconButton OnClick="@((e) => DrawerToggle())"
                       Edge="Edge.Start"
                       Color="Color.Inherit"
                       Icon="@Icons.Material.Filled.Menu" />
        </MudTooltip>

        <!-- لوجو أو عنوان -->
        <MudText Typo="Typo.h6" Class="ml-3 fw-bold">
            One-ERP 🏪
        </MudText>

        <MudSpacer />

        <!-- زر تغيير اللغة -->
        <MudTooltip Text="@(IsArabic ? trgma.SwitchToEnglish : trgma.SwitchToArabic)" Color="Color.Primary" Placement="Placement.Bottom" Arrow="true">
            <MudIconButton Color="Color.Inherit"
                           Icon="@Icons.Material.Filled.Translate"
                           OnClick="@ToggleLang" />
        </MudTooltip>

        <!-- زر تغيير الـ Theme -->
        <MudTooltip Text="@trgma.ChangeStyle" Color="Color.Primary" Placement="Placement.Bottom" Arrow="true">
        <MudIconButton Color="Color.Inherit"
                       Icon="@(UI.IsDark ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                       OnClick="@(() => UI.ToggleDark())" />
        </MudTooltip>

        <!-- زر تسجيل الخروج -->
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit">
            @if (IsSuperAdmin)
            {
                <MudMenuItem Href="/sysadmin/companies" Icon="@Icons.Material.Filled.Business">@trgma.ManageCompanies</MudMenuItem>
                <MudMenuItem Href="/register-user" Icon="@Icons.Material.Filled.PersonAdd">@trgma.CreateUser</MudMenuItem>
                <MudDivider />
            }
            else if (IsUserAdmin)
            {
                <MudMenuItem Href="/register-user" Icon="@Icons.Material.Filled.PersonAdd">@trgma.RegisterNewUser</MudMenuItem>
                <MudDivider />
            }
            <MudMenuItem OnClick="@Logout" Icon="@Icons.Material.Filled.Logout">@trgma.LogOut</MudMenuItem>
        </MudMenu>
    </MudAppBar>

        @if (authenticationService.CheckAuthentication())
    {
    <!-- Drawer -->
    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="2"
               Anchor="@(IsArabic ? Anchor.Right : Anchor.Left)">
        <NavMenu @key="_localizer.CurrentCulture" />
    </MudDrawer>
    }
    <!-- Main Content -->
    <MudMainContent>
        <MudContainer Class="mt-4 px-4" MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>
}

@code {
    private bool _drawerOpen = true;
    private bool _initializing = true;
    private System.Security.Claims.ClaimsPrincipal? _user;

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    // Fix #8: Use AuthenticationState claims instead of manual JWT parsing
    private bool IsUserAdmin => _user?.IsInRole("CompanyAdmin") == true || _user?.IsInRole("Admin") == true;
    private bool IsSuperAdmin => _user?.IsInRole("SuperAdmin") == true;

    protected override async Task OnInitializedAsync()
    {
        // Show loader while initializing
        _initializing = true;
        StateHasChanged();

        // Fix #8: Load claims from AuthenticationState instead of parsing JWT manually
        if (AuthState is not null)
        {
            var state = await AuthState;
            _user = state.User;
        }

        _localizer.InitLocalizedComponent(this);
        await SetLanguage(LanguageState.Arabic);

        UI.SetRtl(IsArabic);

        // Onboarding Check - Skip for SuperAdmin (they don't need a company code)
        try {
            // SuperAdmin check - if already logged in as SuperAdmin, skip onboarding and FORCE dashboard
            if (IsSuperAdmin)
            {
                 var uri = _nav.ToAbsoluteUri(_nav.Uri);
                 // If on root or onboarding, go to dashboard
                 if (uri.AbsolutePath.Equals("/") || uri.AbsolutePath.Contains("onboarding") || uri.AbsolutePath.Contains("login"))
                 {
                     _initializing = false;
                     StateHasChanged();
                     _nav.NavigateTo("/superadmin/dashboard");
                     return;
                 }
            }
            else
            {
                var code = await _clientStorage.GetAsync("company_code");
                if (string.IsNullOrEmpty(code))
                {
                    // To avoid infinite loop if already on onboarding
                    var uri = _nav.ToAbsoluteUri(_nav.Uri);
                    if (!uri.AbsolutePath.Contains("onboarding") && !uri.AbsolutePath.Contains("superadmin"))
                    {
                        _initializing = false;
                        StateHasChanged();
                        _nav.NavigateTo("/onboarding");
                        return;
                    }
                }
            }
        } catch {}

        _initializing = false;
    }

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    bool IsArabic => _localizer.CurrentCulture?.TwoLetterISOLanguageName == "ar";

    private async Task SetLanguage(LanguageState lang)
    {
        var culture = lang switch
        {
            LanguageState.English => "en-US",
            LanguageState.Arabic => "ar",
            _ => "en-US"
        };

        await Task.Run(() => _localizer.SetLanguage(System.Globalization.CultureInfo.GetCultureInfo(culture)));

        // حدّث الـ RTL في UiState عشان ينعكس على الـ MudRTLProvider في App.razor
        UI.SetRtl(culture.StartsWith("ar"));
        StateHasChanged();
    }

    private async Task ToggleLang()
    {
        if (IsArabic) await SetLanguage(LanguageState.English);
        else await SetLanguage(LanguageState.Arabic);
    }

    private async Task Logout()
    {
        One.Shared.Services.ApiService.AuthToken = null;
        authenticationService.SetAuthentication(false);

        // Fix #2: Clear the new token key (auth:token:v2)
        try { await _clientStorage.RemoveAsync("auth:token:v2"); } catch { }
        try { await _clientStorage.RemoveAsync("superadmin:token:v1"); } catch { }

        await _msg.NotifySuccess(trgma.LoggedOutSuccessfully);
        _nav.NavigateTo("/onboarding");
    }
}
