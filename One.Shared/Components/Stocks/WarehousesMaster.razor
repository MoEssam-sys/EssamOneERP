@page "/Warehouse"
@using System.Net.Http.Json
@using One.Domain.Base
@using One.Domain.DTOs
@using One.Domain.DTOs.Stocks
@using One.Domain.Entities.Stocks
@using One.Domain.DTOs.Sales
@using One.Domain.Entities.Sales

<!-- Breadcrumb (لو عندك كومبوننت OneBreadcrumbs) -->
<OneBreadcrumbs BreadItems="_breadcrumbs" BreadColor="Color.Primary" />

<MudGrid Class="mt-4">
    <!-- الفورم -->
    <MudItem xs="12" md="5">
        <MudCard Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">المستودع</MudText>
            <MudDivider Class="mb-3" />

            <MudForm @ref="FormRef" @bind-IsValid="FormValid">
                <MudTextField @bind-Value="FormCode"
                Label="الكود"
                Required="true"
                Disabled="@_isEditing"
                Margin="Margin.Dense"
                Variant="Variant.Outlined" />

                <MudTextField @bind-Value="FormName"
                Label="الاسم"
                Required="true"
                Margin="Margin.Dense"
                Variant="Variant.Outlined" />


                <MudSelect @bind-Value="FormBranchId"
                Label="@trgma.Warehouse"
                Margin="Margin.Dense"
                Variant="Variant.Outlined">
                    @foreach (var branch in BranchesList)
                    {
                        <MudSelectItem Value="branch.Id">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSwitch T="bool" @bind-Value="FormIsActive"
                Color="Color.Success"
                Class="mt-2"
                Label="نشط" />


                <MudStack Row Class="mt-3" Spacing="2">
                    <OneLoadingBtn ButtonText="@(_isEditing ? "تعديل" : "إنشاء")"
                    LoadingText="جاري الحفظ..."
                    Color="Color.Primary"
                    OnClick="@SaveAsync" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@ResetForm">
                        إلغاء
                    </MudButton>
                </MudStack>
            </MudForm>
        </MudCard>
    </MudItem>

    <!-- الجدول -->
    <MudItem xs="12" md="7">
        <MudCard Class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">قائمة المستودعات </MudText>
            <MudDivider Class="mb-3" />

            <MudDataGrid @ref="_grid"
            T="Warehouses"
            Items="WarehouseRows"
            Hover="true"
            Dense="true"
            Bordered="true"
            Elevation="0"
            Filterable="false"
            RowClick="OnRowClick">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">قائمة المستودعات </MudText>
                    <MudSpacer />
                    <MudTextField T="string"
                    Value="_search"
                    ValueChanged="OnSearch"
                    Placeholder="ابحث بالكود أو الاسم"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    Immediate="true"
                    DebounceInterval="300"
                    Class="mt-0" />
                </ToolBarContent>

                <Columns>
                    <PropertyColumn T="Warehouses" TProperty="string" Property="x => x.Code" Title="الكود" />
                    <PropertyColumn T="Warehouses" TProperty="string" Property="x => x.Name" Title="الاسم" />
                    <TemplateColumn T="Warehouses" Title="نشط">
                        <CellTemplate>
                            @if (context.Item.IsActive)
                            {
                                <MudChip T="@string" Color="Color.Success" Variant="Variant.Outlined">نشط</MudChip>
                            }
                            else
                            {
                                <MudChip T="@string" Color="Color.Error" Variant="Variant.Outlined">غير نشط</MudChip>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                            Color="Color.Error"
                            OnClick="@(() => ConfirmAndDeleteAsync(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="Warehouses" />
                </PagerContent>
            </MudDataGrid>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    // ====== Breadcrumb ======
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("الإعدادات", href: "/settings"),
        new("المستودعات", href: "/Warehouse", disabled: true)
    };

    // ====== Form ======
    private MudForm FormRef = new();
    private bool FormValid;
    private bool _isEditing = false;
    private Guid? EditingId = null;

    private string FormCode = string.Empty;
    private string FormName = string.Empty;
    private Guid? FormBranchId;
    private bool FormIsActive { get; set; } = true;

    // ====== Data ======
    private List<Warehouses> WarehouseRows = new();
    private List<Branches> BranchesList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    } 
 
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await LoadBranchesAsync();
    }
    // -------- API Calls --------
    private async Task LoadAsync(int pageNumber = 1, int pageSize = 10, string? query = null)
    {
        try
        {
            var filter = new FilterWarehouseRequest
                {
                    PageNumber = pageNumber,
                    PageSize = pageSize,
                };

            var resp = await _http.PostAsJsonAsync("api/stocks/Warehouses/filter", filter);
            var res = await resp.Content.ReadFromJsonAsync<Result<PagedResult<Warehouses>>>();

            if (res?.Success == true && res.Data is not null)
            {
                WarehouseRows = res.Data.Items?.ToList() ?? new List<Warehouses>();
            }
            else
            {
                await ShowError(res?.Messages ?? new() { "فشل في تحميل البيانات." });
            }
        }
        catch (Exception ex)
        {
            await ShowError(new() { $"خطأ في الاتصال: {ex.Message}" });
        }
        StateHasChanged();
    }
    private async Task LoadBranchesAsync(int pageNumber = 1, int pageSize = 10, string? query = null)
    {
        try
        {
            
            var resp = await _http.PostAsJsonAsync("api/sales/branches/search",
                new SearchRequest { });

            if (!resp.IsSuccessStatusCode)
            {
                var raw = await resp.Content.ReadAsStringAsync();
                await ShowError(new()
                {
                    $"HTTP {(int)resp.StatusCode} {resp.ReasonPhrase}",
                    string.IsNullOrWhiteSpace(raw) ? "No content body." : raw
                });
                BranchesList = new();
                return;
            }

            var payload = await resp.Content.ReadFromJsonAsync<Result<List<Branches>>>();

            if (payload?.Success == true && payload.Data is not null)
            {
                BranchesList = payload.Data;
                StateHasChanged();
            }
            else
            {
                await ShowError(payload?.Messages ?? new() { "فشل في تحميل البيانات." });
                BranchesList = new();
            }
        }
        catch (Exception ex)
        {
            await ShowError(new() { $"خطأ في الاتصال: {ex.Message}" });
            BranchesList = new();
        }
    }


    private async Task ResetForm()
    {
        EditingId = null;
        FormCode = string.Empty;
        FormName = string.Empty;
        FormBranchId = null;
        FormIsActive = true;
        _isEditing = false;
        await FormRef.ResetAsync();
    }

    // -------- Helpers --------

    // المرجع للـ DataGrid
    private MudDataGrid<Warehouses>? _grid;

    // نص البحث
    private string? _search;

    // ===== Server Data for MudDataGrid =====
    private async Task<GridData<Warehouses>> ServerReload(GridState<Warehouses> state)
    {
        try
        {
            var filter = new FilterWarehouseRequest
                {
                    PageNumber = state.Page + 1,
                    PageSize = state.PageSize,
                };

            var resp = await _http.PostAsJsonAsync("api/stocks/Warehouses/filter", filter);

            // لو حبّيت تعتمد على الهيدرز للـ Total:
            int? totalFromHeader = TryGetHeaderInt(resp, "X-Total-Count");

            var payload = await resp.Content.ReadFromJsonAsync<Result<PagedResult<Warehouses>>>();

            if (payload?.Success == true && payload.Data is not null)
            {
                var items = payload.Data.Items ?? new List<Warehouses>();
                var total = totalFromHeader ?? payload.Data.TotalCount;

                return new GridData<Warehouses>
                    {
                        Items = items,
                        TotalItems = total
                    };
            }

            await ShowError(payload?.Messages ?? new() { "فشل تحميل البيانات." });
            return new GridData<Warehouses> { Items = Array.Empty<Warehouses>(), TotalItems = 0 };
        }
        catch (Exception ex)
        {
            await ShowError(new() { $"خطأ في الاتصال: {ex.Message}" });
            return new GridData<Warehouses> { Items = Array.Empty<Warehouses>(), TotalItems = 0 };
        }
    }

    private async Task OnSearch(string text)
    {
        try
        {
            _search = text;
            if (String.IsNullOrEmpty(_search))
            {
                LoadAsync();
                return;
            }
            var resp = await _http.PostAsJsonAsync("api/stocks/Warehouses/search",
                new SearchRequest { Query = _search });

            if (!resp.IsSuccessStatusCode)
            {
                var raw = await resp.Content.ReadAsStringAsync();
                await ShowError(new()
            {
                $"HTTP {(int)resp.StatusCode} {resp.ReasonPhrase}",
                string.IsNullOrWhiteSpace(raw) ? "No content body." : raw
            });
                WarehouseRows = new();
                return;
            }

            var payload = await resp.Content.ReadFromJsonAsync<Result<List<Warehouses>>>();

            if (payload?.Success == true && payload.Data is not null)
            {
                WarehouseRows = payload.Data;
            }
            else
            {
                await ShowError(payload?.Messages ?? new() { "فشل البحث." });
                WarehouseRows = new();
            }
        }
        catch (Exception ex)
        {
            await ShowError(new() { $"خطأ في الاتصال: {ex.Message}" });
            WarehouseRows = new();
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<Warehouses> e)
    {
        var b = e.Item;
        EditingId = b.Id;
        FormCode = b.Code ?? string.Empty;
        FormName = b.Name ?? string.Empty;
        FormBranchId = b.BranchId;
        FormIsActive = b.IsActive;
        _isEditing = true;
    }

    private async Task SaveAsync()
    {
        await FormRef!.Validate();
        if (!FormValid)
        {
            await _msg.NotifyInfo("من فضلك أكمل البيانات المطلوبة.");
            return;
        }
        var test = FormBranchId;
        try
        {
            if (_isEditing && EditingId.HasValue)
            {
                var dto = new UpdateWarehouseRequest
                    {
                        Id = EditingId.Value,
                        Name = FormName,
                        BranchId = FormBranchId ?? new Guid(),
                        IsActive = FormIsActive
                    };

                var resp = await _http.PutAsJsonAsync("api/stocks/Warehouses/update", dto);
                var res = await resp.Content.ReadFromJsonAsync<Result<bool>>();

                if (res?.Success == true)
                {
                    var activeDto = new ActiveWarehouseRequest { Id = EditingId.Value, IsActive = FormIsActive };
                    var actResp = await _http.PutAsJsonAsync("api/stocks/Warehouses/active", activeDto);
                    var actRes = await actResp.Content.ReadFromJsonAsync<Result<bool>>();
                    if (actRes?.Success != true)
                        await _msg.NotifyWarning("فشل تعديل حالة النشاط.");

                    await _msg.UpdatedSuccessfully("Branch");
                    await LoadAsync();
                    await ResetForm();
                }
                else
                {
                    await ShowError(res?.Messages ?? new() { "فشل في التعديل." });
                }
            }
            else
            {
                var dto = new CreateWarehouseRequest
                    {
                        Code = FormCode,
                        Name = FormName,
                        IsActive = FormIsActive,
                        BranchId = FormBranchId ?? new Guid()
                    };

                var resp = await _http.PostAsJsonAsync("api/stocks/Warehouses/create", dto);
                var res = await resp.Content.ReadFromJsonAsync<Result<Warehouses>>();
                if (res?.Success == true)
                {
                    await _msg.CreatedSuccessfully("Branch");
                    await LoadAsync();
                    await ResetForm();
                }
                else
                {
                    await ShowError(res?.Messages ?? new() { "فشل في الإنشاء." });
                }
            }
        }
        catch (Exception ex)
        {
            await ShowError(new() { $"خطأ في الاتصال: {ex.Message}" });
        }
    }

    private async Task ConfirmAndDeleteAsync(Warehouses row)
    {
        var ok = await _msg.ConfirmMsg("هل تريد الحذف", "نعم", "إلغاء", "تحذير");
        if (!ok) return;

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, "api/stocks/Warehouses/delete")
                {
                    Content = JsonContent.Create(row.Id)
                };
            var resp = await _http.SendAsync(request);
            var res = await resp.Content.ReadFromJsonAsync<Result<bool>>();

            if (res?.Success == true)
            {
                await _msg.DeletedSuccessfully("Branch");
                await LoadAsync();
            }
            else
            {
                await ShowError(res?.Messages ?? new() { "فشل في الحذف." });
            }
        }
        catch (Exception ex)
        {
            await ShowError(new() { $"خطأ في الاتصال: {ex.Message}" });
        }
    }


    // ===== Helpers =====
    private static int? TryGetHeaderInt(HttpResponseMessage resp, string name)
        => resp.Headers.TryGetValues(name, out var vals) && int.TryParse(vals.FirstOrDefault(), out var n) ? n : null;

    private async Task ShowError(List<string?> msgs)
    {
        var text = (msgs?.Where(m => !string.IsNullOrWhiteSpace(m)).ToArray() ?? Array.Empty<string>())
                   .DefaultIfEmpty("حدث خطأ غير متوقع.").ToArray();
        foreach (var m in text) await _msg.Error(m!);
    }

    public sealed class PagedResult<TItem>
    {
        public List<TItem> Items { get; set; } = new();
        public int TotalCount { get; set; }
        public int PageNumber { get; set; }
        public int PageSize { get; set; }
    }
}
