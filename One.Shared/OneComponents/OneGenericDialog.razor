@using MudBlazor

<MudDialog @bind-Visible="IsVisible" Options="DialogOptions">
    <DialogContent>
        @ChildContent
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public DialogOptions DialogOptions { get; set; } = new DialogOptions() { CloseButton = true, BackdropClick = false };

    async Task CloseDialog()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }
}