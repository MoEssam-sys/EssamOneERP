@using MudBlazor

@* <OneLoader Visible="@IsLoading"
               Text="جاري تحميل البيانات..."
               LoaderType="LoaderType.LoaderType.Writer" /> *@

<MudOverlay DarkBackground="true" @bind-Visible="Visible" Style="z-index:999999!important">
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;">
        @switch (LoaderType)
        {
            case LoaderType.OneERP:
                <div class="loader-onerp">
                    <span>@Text</span>
                    <span>@Text</span>
                </div>
                break;
            case LoaderType.Wifi:
                <div class="wifi-loader-custom">
                    <svg class="circle-outer" viewBox="0 0 86 86"><circle class="back" cx="43" cy="43" r="41"></circle><circle class="front" cx="43" cy="43" r="41"></circle></svg>
                    <svg class="circle-middle" viewBox="0 0 60 60"><circle class="back" cx="30" cy="30" r="28"></circle><circle class="front" cx="30" cy="30" r="28"></circle></svg>
                    <svg class="circle-inner" viewBox="0 0 34 34"><circle class="back" cx="17" cy="17" r="15"></circle><circle class="front" cx="17" cy="17" r="15"></circle></svg>
                    <div class="wifi-loader-text" data-text="@Text"></div>
                </div>
                break;
            case LoaderType.Hand:
                <div class="loader-hand">
                    <span class="hand-palm"></span>
                    <span class="hand-thumb"></span>
                    <span class="hand-finger"></span>
                    <span class="hand-finger"></span>
                    <span class="hand-finger"></span>
                    <span class="hand-finger"></span>
                </div>
                <span style="color:#333;font-weight:bold;margin-top:24px;">@Text</span>
                break;
            case LoaderType.Circles:
                <svg class="loader-circles" viewBox="0 0 220 220">
                    <circle class="loader-circles__ring loader-circles__ring--a" cx="110" cy="110" r="100" stroke-width="20" fill="none" />
                    <circle class="loader-circles__ring loader-circles__ring--b" cx="110" cy="110" r="70" stroke-width="20" fill="none" />
                    <circle class="loader-circles__ring loader-circles__ring--c" cx="110" cy="110" r="40" stroke-width="20" fill="none" />
                    <circle class="loader-circles__ring loader-circles__ring--d" cx="110" cy="110" r="10" stroke-width="20" fill="none" />
                </svg>
                <span style="color:#333;font-weight:bold;margin-top:24px;">@Text</span>
                break;
            case LoaderType.Writer:
                <div class="loader-writter">
                    <span class="slide"><i></i></span>
                    <span class="paper"></span>
                    <span class="keyboard"></span>
                </div>
                <span style="color:#333;font-weight:bold;margin-top:24px;">@Text</span>
                break;
            case LoaderType.DayNight:
                <div class="scene loader-daynight-scene">
                    <div class="forest">
                        <div class="tree tree1">
                            <div class="branch branch-top"></div>
                            <div class="branch branch-middle"></div>
                            <div class="branch branch-bottom"></div>
                        </div>
                        <div class="tree tree2">
                            <div class="branch branch-top"></div>
                            <div class="branch branch-middle"></div>
                            <div class="branch branch-bottom"></div>
                        </div>
                        <div class="tree tree3">
                            <div class="branch branch-top"></div>
                            <div class="branch branch-middle"></div>
                            <div class="branch branch-bottom"></div>
                        </div>
                        <div class="tree tree4">
                            <div class="branch branch-top"></div>
                            <div class="branch branch-middle"></div>
                            <div class="branch branch-bottom"></div>
                        </div>
                        <div class="tree tree5">
                            <div class="branch branch-top"></div>
                            <div class="branch branch-middle"></div>
                            <div class="branch branch-bottom"></div>
                        </div>
                        <div class="tree tree6">
                            <div class="branch branch-top"></div>
                            <div class="branch branch-middle"></div>
                            <div class="branch branch-bottom"></div>
                        </div>
                        <div class="tree tree7">
                            <div class="branch branch-top"></div>
                            <div class="branch branch-middle"></div>
                            <div class="branch branch-bottom"></div>
                        </div>
                    </div>
                    <div class="tent">
                        <div class="roof"></div>
                        <div class="roof-border-left">
                            <div class="roof-border roof-border1"></div>
                            <div class="roof-border roof-border2"></div>
                            <div class="roof-border roof-border3"></div>
                        </div>
                        <div class="left-door">
                            <div class="left-door-inner"></div>
                        </div>
                        <div class="right-door">
                            <div class="right-door-inner"></div>
                        </div>
                    </div>
                    <div class="floor">
                        <div class="ground ground1"></div>
                        <div class="ground ground2"></div>
                    </div>
                    <div class="fireplace">
                        <div class="support"></div>
                        <div class="support"></div>
                        <div class="bar"></div>
                        <div class="hanger"></div>
                        <div class="pan"></div>
                        <div class="smoke"></div>
                        <div class="fire">
                            <div class="line line1">
                                <div class="particle particle1"></div>
                                <div class="particle particle2"></div>
                                <div class="particle particle3"></div>
                                <div class="particle particle4"></div>
                            </div>
                            <div class="line line2">
                                <div class="particle particle1"></div>
                                <div class="particle particle2"></div>
                                <div class="particle particle3"></div>
                                <div class="particle particle4"></div>
                            </div>
                            <div class="line line3">
                                <div class="particle particle1"></div>
                                <div class="particle particle2"></div>
                                <div class="particle particle3"></div>
                                <div class="particle particle4"></div>
                            </div>
                        </div>
                    </div>
                    <div class="time-wrapper">
                        <div class="time">
                            <div class="day"></div>
                            <div class="night">
                                <div class="star star1"></div>
                                <div class="star star2"></div>
                                <div class="star star3"></div>
                                <div class="star star4"></div>
                                <div class="star star5"></div>
                                <div class="star star6"></div>
                                <div class="star star7"></div>
                                <div class="moon"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <span style="color:#333;font-weight:bold;margin-top:24px;">@Text</span>
                break;
        }
    </div>
</MudOverlay>

@code {
    [Parameter]
    public bool Visible { get; set; } = false;

    [Parameter]
    public string Text { get; set; } = "Loading...";

    [Parameter]
    public LoaderType LoaderType { get; set; } = LoaderType.OneERP;

}
