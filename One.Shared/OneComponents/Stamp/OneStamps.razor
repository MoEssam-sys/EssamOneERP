        switch (btn)
        {
            case OneBtnClick.Save:
                break;

            case OneBtnClick.Update:
                UpdateState = true;
                break;

            case OneBtnClick.Clear:
                break;

            case OneBtnClick.Delete:
                break;
        }
        OverlayLoad = false; StateHasChanged();
    }

