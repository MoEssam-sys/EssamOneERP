@* <MudTable T="FacultySelectOutput" @ref="ItemsTableRef" Items="Papa.Lists.FacultiesList"
          ReadOnly="!UpdateState"
          Hover="true"
          Dense="true"
          Striped="true"
          Bordered="true"
          Virtualize="true"
          CustomFooter="true"
          MultiSelection="false"
          IsEditRowSwitchingBlocked="false"
          SortLabel="@Tr("SortBy")"
          LoadingProgressColor="Color.Tertiary">

    <HeaderContent>
        <MudTh Class="bordered"><MudTableSortLabel SortBy="new Func<FacultySelectOutput, object>(x => x.FacName)">@Tr("FacName")</MudTableSortLabel></MudTh>
        <MudTh Class="bordered">@Tr("Gender")</MudTh>
        <MudTh Class="bordered"><MudTableSortLabel SortBy="new Func<FacultySelectOutput, object>(x => x.Dean)">@Tr("Dean")</MudTableSortLabel></MudTh>
        <MudTh Class="bordered"><MudTableSortLabel SortBy="new Func<FacultySelectOutput, object>(x => x.SubDean)">@Tr("SubDean")</MudTableSortLabel></MudTh>
        <MudTh Class="bordered"><MudTableSortLabel SortBy="new Func<FacultySelectOutput, object>(x => x.Manger)">@Tr("Manger")</MudTableSortLabel></MudTh>
        <MudTh Class="bordered"><MudTableSortLabel SortBy="new Func<FacultySelectOutput, object>(x => x.HeadStdAff)">@Tr("HeadStdAff")</MudTableSortLabel></MudTh>
        <MudTh Class="bordered"><MudTableSortLabel SortBy="new Func<FacultySelectOutput, object>(x => x.FacImage)">@Tr("FacImage")</MudTableSortLabel></MudTh>
        <MudTh Class="bordered"><MudTableSortLabel SortBy="new Func<FacultySelectOutput, object>(x => x.StampImage)">@Tr("StampImage")</MudTableSortLabel></MudTh>
        <MudTh Class="bordered">@Tr("YearName")</MudTh>
        <MudTh Class="bordered">@Tr("Actions")</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Item Code" @onclick="() => RowSelect(context)">
            <MudAutocomplete T="Product" PopoverClass="ItemListClass" InputId="@($"RiProduct{context.LineNum}")"
                             Value="context.Product"
                             ValueChanged="(v)=>ItemChange(v,context)"
                             @onfocusin="@(() => SelectAllText($"RiProduct{context.LineNum}"))"
                             SearchFunc="@ItemSearch"
                             ToStringFunc="@(e=> e == null ? null : $"{e.Code}")"
                             Dense="true"
                             Strict="false"
                             Required="true"
                             Immediate="true"
                             Underline="false"
                             CoerceText="false"
                             SelectValueOnTab="true"
                             ResetValueOnEmptyText="true"
                             ShowProgressIndicator="true"
                             Disabled="ReadState || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                             Margin="Margin.Dense"
                             AdornmentColor="Color.Tertiary"
                             AnchorOrigin="Origin.BottomCenter"
                             Adornment="@(ReadState?Adornment.None:Adornment.End)"
                             ProgressIndicatorColor="Color.Success">
                <NoItemsTemplate>
                    <MudText Align="Align.Center" Class="px-4 py-1">
                        @Tr("NoItemsFound")
                    </MudText>
                </NoItemsTemplate>

                <BeforeItemsTemplate>
                    <MudGrid Class="d-flex padding-top">
                        <MudItem Class="padding-inside" lg="1" md="1">
                            <b>@Tr("Code")</b>
                        </MudItem>
                        <MudItem Class="padding-inside" lg="4" md="4">
                            <b>@Tr("EnglishDesc")</b>
                        </MudItem>
                        <MudItem Class="padding-inside" lg="4" md="4">
                            <b>@Tr("ArabicDesc")</b>
                        </MudItem>
                    </MudGrid>
                </BeforeItemsTemplate>

                <ItemTemplate Context="e">
                    <MudGrid Class="d-flex padding-items">
                        <MudItem lg="1" md="1" Style="overflow:hidden;">
                            <MudHighlighter Text="@e.Code" HighlightedText="@ItemHighlighterText" Style="background-color:gold;font-weight:bold;padding:0px;"></MudHighlighter>
                        </MudItem>
                        <MudItem lg="4" md="4" Style="overflow:hidden;">
                            <MudHighlighter Text="@e.EnglishDesc" HighlightedText="@ItemHighlighterText" Style="background-color:gold;font-weight:bold;padding:0px"></MudHighlighter>
                        </MudItem>
                        <MudItem lg="4" md="4" Style="overflow:hidden;">
                            <MudHighlighter Text="@e.ArabicDesc" HighlightedText="@ItemHighlighterText" Style="background-color:gold;font-weight:bold;padding:0px"></MudHighlighter>
                        </MudItem>
                    </MudGrid>
                </ItemTemplate>
            </MudAutocomplete>
        </MudTd>

        <MudTd Style="background-color:rgba(0, 0, 0, .09)" DataLabel="Item Desc" @onclick="() => RowSelect(context)">
            <MudTextField @bind-Value="context.Product.EnglishDesc"
                            InputId="@($"RiDesc{context.LineNum}")"
                            OnKeyDown="@((e) => FocusNextInput(e, $"RiQty{context.LineNum}"))"
                            @onfocusin="@(() => SelectAllText($"RiDesc{context.LineNum}"))"
                            Required="true"
                            Underline="false"
                            Disabled="ReadState  || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                            Margin="Margin.Dense"></MudTextField>
        </MudTd>

        <MudTd DataLabel="Unit" @onclick="() => RowSelectUnit(context)">
            <MudSelect T="Unit"
                       Value="context.Unit"
                       ValueChanged="(value)=> UnitChanged(value,context)"
                       InputId="@($"RiUnit{context.LineNum}")"
                       @onfocusin="@(() => SelectAllText($"RiUnit{context.LineNum}"))"
                       Dense="true"
                       Strict="false"
                       Required="true"
                       Underline="false"
                       Disabled="ReadState  || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                       Margin="Margin.Dense"
                       Adornment="Adornment.End"
                       AdornmentColor="Color.Tertiary"
                       AnchorOrigin="Origin.BottomCenter"
                       ToStringFunc="@(e=> e==null?null : EnglishCulture?e.EnglishDesc:e.ArabicDesc)">
                @if (context.UnitsList.IsNotNullOrEmptyList())
                {
                    @foreach (var item in context.UnitsList)
                    {
                        <MudSelectItem Value="@item">@(EnglishCulture ? item.EnglishDesc : item.ArabicDesc)</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudTd>

        <MudTd DataLabel="Qty" @onclick="() => RowSelect(context)">
            <MudNumericField @bind-Value="context.Qty" T="decimal"
                             InputId="@($"RiQty{context.LineNum}")"
                             OnKeyDown="@((e) => FocusNextInput(e, $"RiFreeQty{context.LineNum}"))"
                             @onfocusin="@(() => SelectAllText($"RiQty{context.LineNum}"))"
                             TextChanged="() => CalculationTextChange(context)"
                             Min="0"
                             Format="N0"
                             Underline="false"
                             Disabled="ReadState  || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                             Class="NoRight"
                             Margin="Margin.Dense"
                             HideSpinButtons="true"></MudNumericField>
        </MudTd>

        <MudTd DataLabel="Total">
            <MudTextField @bind-Value="context.TotalDiscountAmountFC"
                          Format="N4"
                          Disabled="true"
                          Underline="false"
                          ShrinkLabel="true"
                          Class="NoRight"
                          Margin="Margin.Dense"></MudTextField>
        </MudTd>

        <MudTd DataLabel="Narration" @onclick="() => RowSelect(context)">
            <MudTextField @bind-Value="context.Narration"
                          InputId="@($"RiNarration{context.LineNum}")"
                          OnKeyDown="@((e)=>OnEnterLastColumn(e, context.LineNum))"
                          @onfocusin="@(() => SelectAllText($"RiNarration{context.LineNum}"))"
                          Underline="false"
                          Disabled="ReadState  || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                          Margin="Margin.Dense"></MudTextField>
        </MudTd>

            <MudTd DataLabel="Actions" Class="sticky-right-column bordered">
                <MudIconButton OnClick="()=>DeleteItemAsync(context)"
                               Disabled="ReadState  || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                               Size="@Size.Small"
                               Color="@Color.Error"
                               Variant="@Variant.Text"
                               Icon="@Icons.Material.Filled.Delete"></MudIconButton>
            </MudTd>
    </RowTemplate>

    <LoadingContent>
        <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-7" />
    </LoadingContent>

    <FooterContent>
        @if (!ReadState)
        {
            <MudTFootRow Class="bold-text bordered">
                <MudTd DataLabel="Item Code" Class="bordered MudThWidth130">
                    <MudAutocomplete T="Product" @ref="FtItemRef" InputId="FtItemId" Value="FtItem"
                                     ValueChanged="FtItemChange"
                                     SearchFunc="@ItemSearch"
                                     ToStringFunc="@(e=> e == null ? null : $"{e.Code}")"
                                     Placeholder="@Tr("Code")"
                                     PopoverClass="ItemListClass"
                                     Dense="true"
                                     Strict="false"
                                     Immediate="true"
                                     Underline="false"
                                     CoerceText="false"
                                     Disabled="ReadState  || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                                     SelectValueOnTab="true"
                                     ResetValueOnEmptyText="true"
                                     ShowProgressIndicator="true"
                                     Margin="Margin.Dense"
                                     Adornment="@(ReadState?Adornment.None:Adornment.End)"
                                     AdornmentColor="Color.Tertiary"
                                     AnchorOrigin="Origin.BottomCenter"
                                     ProgressIndicatorColor="Color.Success">

                        <NoItemsTemplate>
                            <MudText Align="Align.Center" Class="px-4 py-1">
                                @Tr("NoItemsFound")
                            </MudText>
                        </NoItemsTemplate>

                        <BeforeItemsTemplate>
                            <MudGrid Class="d-flex padding-top">
                                <MudItem Class="padding-inside" lg="1" md="1">
                                    <b>@Tr("Code")</b>
                                </MudItem>
                                <MudItem Class="padding-inside" lg="4" md="4">
                                    <b>@Tr("EnglishDesc")</b>
                                </MudItem>
                                <MudItem Class="padding-inside" lg="4" md="4">
                                    <b>@Tr("ArabicDesc")</b>
                                </MudItem>
                            </MudGrid>
                        </BeforeItemsTemplate>

                        <ItemTemplate Context="e">
                            <MudGrid Class="d-flex padding-items">
                                <MudItem lg="1" md="1" Style="overflow:hidden;">
                                    <MudHighlighter Text="@e.Code" HighlightedText="@ItemHighlighterText" Style="background-color:gold;font-weight:bold;padding:0px;"></MudHighlighter>
                                </MudItem>
                                <MudItem lg="4" md="4" Style="overflow:hidden;">
                                    <MudHighlighter Text="@e.EnglishDesc" HighlightedText="@ItemHighlighterText" Style="background-color:gold;font-weight:bold;padding:0px"></MudHighlighter>
                                </MudItem>
                                <MudItem lg="4" md="4" Style="overflow:hidden;">
                                    <MudHighlighter Text="@e.ArabicDesc" HighlightedText="@ItemHighlighterText" Style="background-color:gold;font-weight:bold;padding:0px"></MudHighlighter>
                                </MudItem>
                            </MudGrid>
                        </ItemTemplate>
                    </MudAutocomplete>
                </MudTd>

                <MudTd DataLabel="Item Desc" Class="bordered MudThWidth200">
                    <MudTextField @ref="FtItemNameRef" @bind-Value="FtItemName"
                                  OnKeyDown="@((e) =>{if(e.Key=="Enter") FtUnitRef.FocusAsync();})"
                                  @onfocusin="async ()=> await FtItemNameRef.SelectAsync()"
                                  Underline="false"
                                  Disabled="ReadState  || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                                  Placeholder="@Tr("Name")"
                                  Margin="Margin.Dense"></MudTextField>
                </MudTd>

                <MudTd DataLabel="Unit" Class="bordered MudThWidth130">
                    <MudSelect T="Unit" @ref="FtUnitRef" Value="FtUnit"
                               ValueChanged="FtUnitChanged"
                               Dense="true"
                               Strict="false"
                               Underline="false"
                               Disabled="ReadState  || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                               Placeholder="@Tr("Unit")"
                               Margin="Margin.Dense"
                               Adornment="Adornment.End"
                               AdornmentColor="Color.Tertiary"
                               AnchorOrigin="Origin.BottomCenter"
                               ToStringFunc="@(e=> e==null?null : EnglishCulture?e.EnglishDesc:e.ArabicDesc)">
                        @if (FtUnitList.IsNotNullOrEmptyList())
                        {
                            @foreach (var item in FtUnitList)
                            {
                                <MudSelectItem OnClick="FtUnitOnClick" Value="@item">@(EnglishCulture ? item.EnglishDesc : item.ArabicDesc)</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudTd>

                <MudTd DataLabel="Qty" Class="bordered">
                    <MudNumericField T="decimal" @ref="FtQtyRef" @bind-Value="FtQty"
                                     InputId="@($"FtQtyRef")"
                                     OnKeyDown="@((e) => FocusNextInput(e, $"FtFreeQtyRef"))"
                                     @onfocusin="async ()=> await FtQtyRef.SelectAsync()"
                                     TextChanged="FtQtyTextChange"
                                     Min="0"
                                     Format="N0"
                                     Underline="false"
                                     Disabled="ReadState  || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                                     Class="NoRight"
                                     Margin="Margin.Dense"
                                     HideSpinButtons="true"></MudNumericField>
                </MudTd>

                <MudTd DataLabel="FreeQty" Class="bordered MudThWidth180">
                    <MudNumericField T="decimal" @ref="FtFreeQtyRef" @bind-Value="FtFreeQty"
                                     InputId="@($"FtFreeQtyRef")"
                                     OnKeyDown="@((e) => FocusNextInput(e, $"FtPurPriceRef"))"
                                     @onfocusin="async ()=> await FtFreeQtyRef.SelectAsync()"
                                     Min="0"
                                     Format="N0"
                                     Underline="false"
                                     Disabled="ReadState  || (int)SelectedRfq.PurCycleState >= (int)PurchaseCycleState.PO"
                                     HideSpinButtons="true"
                                     Class="NoRight"
                                     Placeholder="0.000"
                                     Margin="Margin.Dense"
                                     Validation="@(new Func<decimal?, IEnumerable<string>>(ValidDecimalNumber))"></MudNumericField>
                </MudTd>


                <MudTd DataLabel="Actions" Class="bordered sticky-right-column">
                    <MudTooltip Text="@Tr("Clear")"
