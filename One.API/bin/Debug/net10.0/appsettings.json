{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "UserConnection": "${ONEERP_USER_CONNECTION}",
    "MainConnection": "${ONEERP_MAIN_CONNECTION}",
    "LiveConnection": "${ONEERP_LIVE_CONNECTION}"
  },
  "AllowedHosts": "*",
  "JWT": {
    "ValidAudience": "http://localhost:4200",
    "ValidIssuer": "https://localhost:7211",
    "Secret": "${ONEERP_JWT_SECRET}"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:7211",
      "https://localhost:7131",
      "http://localhost:5207"
    ],
    "AllowCredentials": true
  },
  "RateLimiting": {
    "UseRedis": false,
    "RedisConnection": "${ONEERP_REDIS_CONNECTION}",
    "WindowSeconds": 20,
    "MaxRequests": 10
  },
  "Security": {
    "RequireHttpsMetadata": false
  }
}
